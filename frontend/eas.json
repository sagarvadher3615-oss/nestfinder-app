{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://nestfinder-app-backend.onrender.com"
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "env": {
          "EXPO_PUBLIC_BACKEND_URL": "https://nestfinder-app-backend.onrender.com"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
